#!/bin/sh

# Linyux OS — конфигурация live-build (чистый GNOME, i686 32-bit).
#
# Жёсткие требования:
#   1. Архитектура i686 (32-bit): --architecture i386
#                                 --bootstrap-qemu-arch i386 (live-build 20230502
#                                 не принимает длинное имя --bootstrap-qemu-architecture)
#                                 --binary-images iso-hybrid
#   2. Установка на жёсткий диск:  --debian-installer live
#   3. Минимальный старт:          debootstrap --variant=minbase
#      (чистый Debian Minimal install; вариант "minimal" debootstrap не
#      поддерживает, а live-build 20230502 не имеет --bootstrap-variant —
#      minbase ставит base-minimum, минимально возможную чистую базу)
#   4. Локализация en_US.UTF-8 по умолчанию + ru_RU.UTF-8, tt_RU.UTF-8
#      (config/hooks/normal/0020-locales.hook.chroot)
#   5. Чистый GNOME                (config/package-lists/linyux.gnome.list.chroot)
#   6. firefox-esr                 (то же)
#   7. htop, cava, xorg, fastfetch, gnome-system-monitor (то же)

set -e

# Хост-архитектура машины сборки.
HOST_ARCH="$(dpkg --print-architecture)"

# Общие параметры live-build.
COMMON_OPTS="
--architecture i386
--binary-images iso-hybrid
--distribution bookworm
--parent-distribution bookworm
--archive-areas main contrib non-free non-free-firmware
--mirror-bootstrap http://deb.debian.org/debian
--mirror-chroot http://deb.debian.org/debian
--debian-installer live
--debian-installer-distribution bookworm
--bootloaders syslinux
--linux-flavours 686-pae
--mode debian
--system live
--chroot-squashfs-compression-type zstd
--binary-filesystem ext4
--security true
--updates true
"

if [ "${HOST_ARCH}" = "amd64" ]; then
    # Сборка i386 на amd64-хосте (например, GitHub Actions ubuntu-latest):
    # включаем foreign bootstrap через qemu-user-static. Требуется
    # установленный пакет qemu-user-static (--bootstrap-qemu-static).
    QEMU_STATIC="/usr/bin/qemu-i386-static"
    if [ ! -x "${QEMU_STATIC}" ]; then
        echo "E: qemu-user-static (--bootstrap-qemu-static) не найден: ${QEMU_STATIC}" >&2
        exit 1
    fi
    lb config noauto \
        ${COMMON_OPTS} \
        --bootstrap-qemu-arch i386 \
        --bootstrap-qemu-static "${QEMU_STATIC}" \
        --debootstrap-options "--variant=minbase" \
        "${@}"
else
    # Нативная сборка на i386 (или другой родной хост): qemu не нужен —
    # live-build сам определит, что архитектура хоста совпадает с целевой,
    # и выполнит обычный (native) debootstrap minimal.
    lb config noauto \
        ${COMMON_OPTS} \
        --debootstrap-options "--variant=minbase" \
        "${@}"
fi
