#!/bin/sh

# Linyux OS — конфигурация live-build (чистый GNOME, i686 32-bit).
#
# Жёсткие требования:
#   1. Архитектура i686 (32-bit): --architecture i386
#                                 --bootstrap-qemu-arch i386 (live-build 20230502
#                                 не принимает длинное имя --bootstrap-qemu-architecture)
#                                 --binary-images iso-hybrid
#   2. Установка на жёсткий диск:  --debian-installer live
#   3. Минимальный старт:          стандартный debootstrap (variant "standard")
#      (debootstrap по умолчанию ставит чистый Debian Minimal install;
#      варианты minbase / minimal не передаются)
#   4. Локализация en_US.UTF-8 по умолчанию + ru_RU.UTF-8, tt_RU.UTF-8
#      (config/hooks/normal/0020-locales.hook.chroot)
#   5. Чистый GNOME                (config/package-lists/linyux.gnome.list.chroot)
#   6. firefox-esr                 (то же)
#   7. htop, cava, xorg, fastfetch, gnome-system-monitor (то же)

set -e

# Хост-архитектура машины сборки.
HOST_ARCH="$(dpkg --print-architecture)"

# Общие параметры live-build.
COMMON_OPTS="
--architecture i386
--binary-images iso-hybrid
--distribution bookworm
--parent-distribution bookworm
--archive-areas main contrib non-free non-free-firmware
--mirror-bootstrap http://deb.debian.org/debian
--mirror-chroot http://deb.debian.org/debian
--debian-installer live
--debian-installer-distribution bookworm
--bootloaders syslinux
--linux-flavours 686-pae
--mode debian
--system live
--chroot-squashfs-compression-type zstd
--binary-filesystem ext4
--security true
--updates true
"

# Опции foreign-bootstrap через qemu. ВАЖНО: live-build сохраняет параметры
# `lb config` в config/all; если при повторном запуске на нативном хосте их
# НЕ передать, там останутся устаревшие LB_BOOTSTRAP_QEMU_* и сборка сломается.
# Поэтому опции всегда передаются явно: пустое значение == выключено.
QEMU_OPTS=""
if [ "${HOST_ARCH}" != "i386" ]; then
    # Сборка i386 на не-i386 хосте (например, GitHub Actions ubuntu-24.04):
    # включаем foreign bootstrap через qemu-user-static.
    QEMU_STATIC="/usr/bin/qemu-i386-static"
    if [ ! -x "${QEMU_STATIC}" ]; then
        echo "E: qemu-user-static не найден: ${QEMU_STATIC}" >&2
        echo "   Установите пакет qemu-user-static перед запуском lb config." >&2
        exit 1
    fi
    QEMU_OPTS="--bootstrap-qemu-arch i386 --bootstrap-qemu-static ${QEMU_STATIC}"
fi

# NOTE: live-build 20230502 не принимает опции --locale/--locales в lb config;
# LB_LOCALE="en_US.UTF-8" задаётся в config/common (см. также хук локалей).
lb config noauto \
    ${COMMON_OPTS} \
    ${QEMU_OPTS} \
    "${@}"

# Санитария config/all: гарантируем отсутствие variant-флагов bootstrap
# (чистый стандартный debootstrap = Debian Minimal install) и корректное
# состояние qemu-параметров для текущей машины сборки.
sed -i 's/^LB_DEBOOTSTRAP_OPTIONS=.*$/LB_DEBOOTSTRAP_OPTIONS=""/' config/all 2>/dev/null || true
if [ -z "${QEMU_OPTS}" ]; then
    sed -i '/^LB_BOOTSTRAP_QEMU_ARCHITECTURE=/d; /^LB_BOOTSTRAP_QEMU_STATIC=/d' config/all 2>/dev/null || true
fi
